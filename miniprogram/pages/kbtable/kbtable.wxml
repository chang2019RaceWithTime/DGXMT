
<view>
	<view class="canlendarTopView">
			<view class="leftBgView" bindtap="turnleft" data-handle="prev">
				<view class="leftView">◀</view>
			</view>
			<view class="centerView">第 {{week_gap}} 周</view>
			<view class="rightBgView" bindtap="turnright" data-handle="next">
				<view class="rightView">▶</view>
			</view>
		</view>
<view class="top"  >
  <view wx:for="{{['一','二','三','四','五','六','日']}}" class="top-text">周{{item}}</view>
</view>
<view style="background-color:#D2E6B3;color:#7cba23;width:35rpx;float:left;">
      <view wx:for="{{[1,2,3,4,5]}}" class="left"> {{item}}</view>
 </view>
