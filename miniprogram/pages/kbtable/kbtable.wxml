    <view wx:for="{{wlist}}" wx:key="{{index}}" style="margin-left:45rpx;">
      <view data-ddd="{{item.class}}" bindtap="alert" class="flex-item kcb-item"  data-statu="open" data-index="{{index}}" style="margin-left:{{(item.week-1)*100}}rpx;margin-top:{{(item.rank-1)*400+5}}rpx;height:390rpx;background-color:{{colorArrays[index%9]}}">
        <view class="smalltext">{{item.class}}({{item.place}}) </view>
